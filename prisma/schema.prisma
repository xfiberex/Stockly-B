// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// T5-04 — `PARTIALLY_RECEIVED`: ha entrado algo, pero no todo lo pedido. Se llega a él solo por
// `POST /purchase-orders/:id/receipts`; `RECEIVED` significa ya que **todas** las líneas están completas.
enum PurchaseOrderStatus {
  PENDING
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

enum SaleOrderStatus {
  PENDING
  SHIPPED
  CANCELLED
}

// T5-01 — de dónde sale un cambio de coste. La recepción de una compra lo recalcula como
// media ponderada; la edición manual existe para el inventario inicial y para corregir.
enum CostSource {
  PURCHASE_RECEIPT
  MANUAL
}

// T5-10 — clasificación ABC por facturación. Solo se guardan los productos **con ventas** en el
// periodo; uno sin fila en `product_abc` es C sin más, y por eso ninguno desaparece del catálogo.
enum AbcClass {
  A
  B
  C
}

enum StockMovementType {
  IN
  OUT
  ADJUSTMENT
  IMPORT
}

// T3-02 — los tres que la conversión a enums de 2026-06-01 dejó fuera.
//
// No es cosmética: mientras `role` fue `String`, la base aceptaba `"admin"`, `"ADMIN "`
// o cualquier cadena, y el único filtro era el `z.enum` de la ruta. Todo lo que escriba
// saltándose esa ruta —una migración, un seed, un `psql` a mano— podía dejar una cuenta
// con un rol que `requireRole` no reconoce: sin permisos y sin error visible.
// T5-13 — `WAREHOUSE`: recibe compras, envía ventas y mueve stock, sin tocar precios, costes,
// catálogo, usuarios ni configuración. Qué puede cada rol en cada ruta está en la matriz de
// `src/shared/permisos.ts`, y `permisos.test.ts` la recorre contra las rutas montadas.
enum Role {
  ADMIN
  USER
  WAREHOUSE
}

// T4-12 — el idioma en el que se le escribe a este usuario.
//
// **No es la preferencia de la interfaz.** Esa vive en el `localStorage` del navegador y es
// por dispositivo (ver `Stockly-F/src/shared/i18n/idioma.ts`): el mismo usuario puede tener
// el portátil en inglés y el móvil en español, y las dos cosas son correctas. Un correo, en
// cambio, se escribe **una vez y sin nadie delante** —la alerta de stock la dispara una venta,
// no una pantalla—, así que hace falta un idioma guardado por usuario. Este es el último
// efectivo que se le conoce, sincronizado desde el navegador.
enum Idioma {
  ES
  EN
}

// Reflejan `AuditAction` y `AuditEntity` de `audit-logs.service.ts`, que ahora se
// importan del cliente generado en vez de declararse dos veces. Añadir un valor aquí
// es lo que lo hace existir para TypeScript, así que los dos lados no pueden separarse.
enum AuditAction {
  CREATE
  UPDATE
  DELETE
  RESTORE
  STOCK_MOVEMENT
  BULK_STOCK
  ORDER_RECEIVE
  ORDER_CANCEL
  USER_ROLE_CHANGE
  USER_ACTIVATE
  USER_DEACTIVATE
  SALE_SHIP
  SALE_CANCEL
  REFRESH_REUSE
  // T5-07
  COUNT_CLOSE
  COUNT_CANCEL
}

enum AuditEntity {
  Product
  PurchaseOrder
  SaleOrder
  User
  Tag
  Category
  Brand
  Supplier
  InventoryCount
  Customer
}

model Category {
  id              String           @id @default(uuid())
  name            String           @unique
  description     String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  products        Product[]
  inventoryCounts InventoryCount[]

  @@map("categories")
}

model Brand {
  id          String    @id @default(uuid())
  name        String    @unique
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  products    Product[]

  @@map("brands")
}

model Supplier {
  id             String          @id @default(uuid())
  name           String
  email          String?         @unique
  phone          String?
  notes          String?
  // T5-05 — días que tarda en llegar un pedido. `null` es **desconocido**: la sugerencia de
  // reposición usa entonces el ajuste `defaultLeadTimeDays` y lo dice, en vez de suponer cero.
  leadTimeDays   Int?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  products       Product[]
  purchaseOrders PurchaseOrder[]

  @@map("suppliers")
}

model Product {
  id            String               @id @default(uuid())
  name          String
  description   String?
  sku           String?              @unique
  // T5-08 — el código que lleva impreso el artículo: EAN-13, UPC-A, EAN-8 o uno interno. Único
  // como el SKU, y por la misma razón: un escaneo tiene que llevar a **un** producto. El índice
  // único es además lo que hace barata la búsqueda exacta de `GET /products/lookup`.
  barcode       String?              @unique
  price         Decimal              @db.Decimal(10, 2)
  // T5-01 — coste medio ponderado. `null` es **desconocido**, no cero: un producto que nunca
  // se ha comprado ni se ha costeado a mano no vale nada a coste, simplemente no se sabe.
  // Cuatro decimales y no dos, como `price`: una media se recalcula en cada recepción y
  // redondear cada vez a céntimos acumula el error compra tras compra.
  costPrice     Decimal?             @db.Decimal(12, 4)
  stock         Int                  @default(0)
  minStock      Int                  @default(0)
  categoryId    String?
  category      Category?            @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  brandId       String?
  brand         Brand?               @relation(fields: [brandId], references: [id], onDelete: SetNull)
  supplierId    String?
  supplier      Supplier?            @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  imageUrl      String?
  imagePublicId String?
  isActive      Boolean              @default(true)
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  movements     StockMovement[]
  priceHistory  PriceHistory[]
  costHistory   CostHistory[]
  purchaseItems PurchaseOrderItem[]
  saleItems     SaleOrderItem[]
  countLines    InventoryCountLine[]
  tags          Tag[]
  abc           ProductAbc?

  // PostgreSQL no indexa las claves foráneas por sí solo: sin esto, filtrar por
  // categoría, marca o proveedor recorre la tabla entera.
  @@index([categoryId])
  @@index([brandId])
  @@index([supplierId])
  // Todos los listados del catálogo ordenan por `createdAt` y el filtro por estado es
  // opcional, así que hacen falta las dos formas (T2-43):
  //   - sin filtro          → `products_createdAt_idx`
  //   - con `?isActive=`    → el compuesto, que ordena dentro de cada estado.
  // El compuesto sustituye al índice sobre `isActive` solo, que el planificador
  // descartaba en la consulta dominante y solo servía al filtro inverso; como prefijo
  // del compuesto, ese caso sigue cubierto sin un índice propio.
  @@index([createdAt])
  @@index([isActive, createdAt])
  // La búsqueda del catálogo es `ILIKE '%término%'`, y un B-tree no sirve para un patrón
  // que no empieza por prefijo: hay que recorrer la tabla. Un índice GIN de trigramas sí
  // (T2-09). Requiere la extensión `pg_trgm`, que crea la propia migración.
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin)
  @@map("products")
}

// T5-10 — la clase ABC de cada producto con ventas en los últimos doce meses naturales
// completos. Es una **caché**, no un dato: la rellena entera `reports.abc.ts` a partir de las
// ventas, como mucho una vez al día. Existe porque el catálogo filtra por clase, y ese filtro
// tiene que ir en el `where` (T4-15): calcularla en cada listado costaría recorrer un año de
// ventas por página. `revenue` es la facturación del periodo, la que decidió la clase.
model ProductAbc {
  productId String   @id
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  abcClass  AbcClass
  revenue   Decimal  @db.Decimal(14, 2)

  @@index([abcClass])
  @@map("product_abc")
}

// T5-10 — de qué periodo y zona salió `product_abc` y cuándo. Una sola fila (`id = 1`): con
// ella se sabe si la caché sigue valiendo sin tener que mirarla entera.
model AbcCalculation {
  id           Int      @id @default(1)
  from         String
  to           String
  timezone     String
  calculatedAt DateTime

  @@map("abc_calculations")
}

model PriceHistory {
  id        String   @id @default(uuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  oldPrice  Decimal  @db.Decimal(10, 2)
  newPrice  Decimal  @db.Decimal(10, 2)
  createdAt DateTime @default(now())

  @@index([productId])
  @@map("price_history")
}

// T5-01 — cada cambio del coste medio, con su origen. `oldCost` es `null` en la primera
// recepción de un producto sin coste, y `newCost` lo es cuando un ADMIN borra el coste a mano.
model CostHistory {
  id              String         @id @default(uuid())
  productId       String
  product         Product        @relation(fields: [productId], references: [id])
  oldCost         Decimal?       @db.Decimal(12, 4)
  newCost         Decimal?       @db.Decimal(12, 4)
  source          CostSource
  purchaseOrderId String?
  purchaseOrder   PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id], onDelete: SetNull)
  createdAt       DateTime       @default(now())

  // Se lee por producto y del más reciente al más antiguo, paginado.
  @@index([productId, createdAt])
  @@map("cost_history")
}

model PurchaseOrder {
  id          String              @id @default(uuid())
  supplierId  String?
  supplier    Supplier?           @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  status      PurchaseOrderStatus @default(PENDING)
  notes       String?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  items       PurchaseOrderItem[]
  costChanges CostHistory[]

  @@index([status, createdAt])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id               String          @id @default(uuid())
  purchaseOrderId  String
  purchaseOrder    PurchaseOrder   @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  productId        String?
  product          Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  productName      String
  quantity         Int
  // T5-04 — lo que ha entrado de esta línea, entre todas sus recepciones. Nunca pasa de
  // `quantity`. Es lo que retira una cancelación (T0-04): retirar `quantity` de una orden
  // recibida a medias sacaría del inventario unidades que nunca entraron.
  receivedQuantity Int             @default(0)
  unitPrice        Decimal         @db.Decimal(10, 2)
  createdAt        DateTime        @default(now())
  receipts         StockMovement[]

  @@index([purchaseOrderId])
  @@index([productId])
  @@map("purchase_order_items")
}

model StockMovement {
  id                  String             @id @default(uuid())
  productId           String
  product             Product            @relation(fields: [productId], references: [id])
  type                StockMovementType
  delta               Int // positivo = entrada, negativo = salida
  stockAfter          Int // stock resultante tras el movimiento
  note                String?
  createdAt           DateTime           @default(now())
  // T5-09 — la línea de compra que recibió esta entrada. Es lo que fecha cada recepción, también
  // las parciales: la orden solo sabe cuánto lleva recibido, no cuándo llegó cada parte. `null`
  // en todo lo demás (ventas, ajustes, importaciones y la salida que deshace una cancelación).
  purchaseOrderItemId String?
  purchaseOrderItem   PurchaseOrderItem? @relation(fields: [purchaseOrderItemId], references: [id], onDelete: SetNull)

  // El histórico de un producto se lee siempre ordenado por fecha: el índice
  // compuesto sirve el filtro y el orden de una sola pasada.
  @@index([productId, createdAt])
  @@index([createdAt])
  // Sin él, borrar una línea de compra recorre la tabla de movimientos entera para poner a
  // `null` las entradas que apuntan a ella.
  @@index([purchaseOrderItemId])
  @@map("stock_movements")
}

model User {
  id                   String    @id @default(uuid())
  name                 String
  email                String    @unique
  password             String
  role                 Role      @default(USER)
  // Por defecto español: es el idioma de referencia del catálogo, y una cuenta creada por
  // seed o por migración no tiene ningún navegador detrás del que deducirlo (T4-12).
  idioma               Idioma    @default(ES)
  isActive             Boolean   @default(true)
  isVerified           Boolean   @default(false)
  verifyToken          String?   @unique
  verifyExpires        DateTime?
  resetToken           String?   @unique
  resetExpires         DateTime?
  refreshToken         String?   @unique
  refreshExpires       DateTime?
  // T2-31 — el hash del refresh token **anterior**, el que acaba de rotarse. Si llega uno
  // que ya no está en `refreshToken` pero sí aquí, alguien está reutilizando un token ya
  // gastado: la sesión se cierra entera y queda constancia en la auditoría.
  previousRefreshToken String?   @unique
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  notifications Notification[]

  // El buscador de usuarios mira **nombre y correo** con el mismo `ILIKE '%…%'`, así que
  // se indexan los dos: con uno solo, la mitad del `OR` seguiría recorriendo la tabla y
  // el planificador descartaría el índice entero (T2-09).
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin)
  @@index([email(ops: raw("gin_trgm_ops"))], type: Gin)
  @@map("users")
}

model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt

  @@map("app_settings")
}

model AuditLog {
  id        String      @id @default(uuid())
  userId    String?
  userEmail String?
  action    AuditAction
  entity    AuditEntity
  entityId  String?
  details   Json?
  createdAt DateTime    @default(now())

  @@index([createdAt])
  @@index([entity, action])
  @@map("audit_logs")
}

model Tag {
  id        String    @id @default(uuid())
  name      String    @unique
  color     String?
  products  Product[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@map("tags")
}

// ─── T5-06 — Clientes ──────────────────────────────────────────────────────────
//
// Antes de T5-06 el cliente solo existía como tres textos sueltos en cada orden, así que no
// había forma de ver qué había comprado ni de corregir su teléfono una vez para todas.

model Customer {
  id         String      @id @default(uuid())
  name       String
  // **Normalizado**: minúsculas y sin espacios alrededor. Es la clave con la que se agrupan
  // las órdenes —las antiguas en la migración y las nuevas al crearse—, así que
  // `Ana@Correo.com` y `ana@correo.com ` tienen que ser el mismo cliente.
  email      String?     @unique
  phone      String?
  // T6-06 — cédula, RNC, NIF: lo que el comprobante pone junto al nombre. **No es clave de
  // nada**: no es único y no agrupa clientes; eso lo sigue haciendo solo el correo.
  document   String?
  notes      String?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  saleOrders SaleOrder[]

  @@index([name])
  @@map("customers")
}

// T6-04 — de dónde salen los números correlativos. **No es una secuencia de PostgreSQL**, y a
// propósito: una secuencia no se deshace con la transacción, así que cada venta rechazada por
// falta de disponible (409) dejaría un hueco en la serie. Esta fila se incrementa **dentro** de
// la transacción que crea la orden: si la orden no llega a existir, el número tampoco se gastó.
// `key` y no una tabla por serie: el día que haya un número fiscal será otra fila, no este
// correlativo (ROADMAP, Tier 6).
model Counter {
  key   String @id
  value Int

  @@map("counters")
}

model SaleOrder {
  id            String          @id @default(uuid())
  // T6-04 — el número con el que se nombra la venta (`#000123`). Lo da `siguienteNumeroDeVenta`,
  // nunca quien llama. Es interno: borrar una orden pendiente deja un hueco, y se acepta.
  number        Int             @unique
  status        SaleOrderStatus @default(PENDING)
  // T5-06 — opcional: una venta sin correo no se vincula a nadie, y borrar el cliente deja
  // sus órdenes sin él, no las borra.
  customerId    String?
  customer      Customer?       @relation(fields: [customerId], references: [id], onDelete: SetNull)
  // Instantánea de a quién se vendió, **aunque haya cliente**: igual que `productName` en los
  // ítems, una orden pasada tiene que seguir diciendo a quién se envió aunque el cliente
  // cambie después de teléfono o de nombre.
  customerName  String?
  customerEmail String?
  customerPhone String?
  // T6-06 — el documento del cliente, en la instantánea por lo mismo que los tres de arriba.
  customerDocument String?
  // T6-06 — quién registró la venta. El correo y no una clave foránea, como en la auditoría y
  // los conteos: la orden tiene que seguir diciéndolo aunque esa cuenta se desactive o se borre.
  // `null` en las anteriores a este campo que no tenían fila en la auditoría.
  createdByEmail String?
  notes         String?
  // T5-02 — cuándo salió la mercancía. `updatedAt` no sirve para esto: cambia con cualquier
  // edición de la orden, y el margen de un periodo se cuenta por la fecha de envío. Se
  // conserva si después se cancela: el estado ya dice que no cuenta.
  shippedAt     DateTime?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  items         SaleOrderItem[]

  @@index([status, createdAt])
  // El informe de margen filtra por estado y por fecha de envío, en ese orden.
  @@index([status, shippedAt])
  // La ficha del cliente lista sus órdenes de la más reciente a la más antigua.
  @@index([customerId, createdAt])
  // T6-01 — la pantalla de ventas lista por fecha de creación sin filtrar por estado, y los
  // tres índices de arriba empiezan por otra columna: sobre 330 000 órdenes era un recorrido
  // secuencial con ordenación (33 ms) y con este son 0,01 ms (rendimiento.md §13).
  @@index([createdAt])
  @@map("sale_orders")
}

model SaleOrderItem {
  id          String    @id @default(uuid())
  saleOrderId String
  saleOrder   SaleOrder @relation(fields: [saleOrderId], references: [id], onDelete: Cascade)
  productId   String?
  product     Product?  @relation(fields: [productId], references: [id], onDelete: SetNull)
  productName String
  quantity    Int
  unitPrice   Decimal   @db.Decimal(10, 2)
  // T5-02 — el coste medio del producto **en el momento del envío**, congelado igual que
  // `productName` congela el nombre. Calcular el margen de una venta pasada con el coste
  // actual da un número, y está mal. `null` si el producto no tenía coste, si el ítem no
  // está ligado a uno o si la venta se envió antes de que existiera este campo.
  unitCost    Decimal?  @db.Decimal(12, 4)
  // T6-05 — el porcentaje de impuesto **vigente al crear la orden**, congelado como
  // `unitPrice`: cambiar el ajuste después no toca las órdenes que ya existen. `unitPrice`
  // sigue siendo sin impuesto, que es de lo que salen los ingresos y el margen de los
  // informes. `null` en las líneas anteriores a este campo: se lee como «sin impuesto».
  taxRate     Decimal?  @db.Decimal(5, 2)
  createdAt   DateTime  @default(now())

  @@index([saleOrderId])
  @@index([productId])
  @@map("sale_order_items")
}

// ─── T5-07 — Conteo físico de inventario ───────────────────────────────────────
//
// Una sesión recoge lo que hay en la estantería y, al cerrarla, convierte cada diferencia en un
// movimiento `ADJUSTMENT`, todo en una transacción. Lo delicado es **contra qué se compara**:
// cada línea guarda el stock que el sistema esperaba **en el momento de contarla**, y al cerrar
// se aplica la diferencia (`contado − esperado`) sobre el stock de ese momento. Así una venta o
// una recepción entre contar y cerrar no se convierte en merma ni en sobrante.

enum InventoryCountStatus {
  OPEN
  CLOSED
  CANCELLED
}

model InventoryCount {
  id             String               @id @default(uuid())
  status         InventoryCountStatus @default(OPEN)
  note           String?
  // El filtro con el que se abrió: `null` es todo el catálogo activo.
  categoryId     String?
  category       Category?            @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  // Correos y no claves foráneas, como la auditoría: la sesión tiene que seguir diciendo quién la
  // abrió aunque esa cuenta se borre.
  createdByEmail String?
  closedByEmail  String?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  closedAt       DateTime?
  lines          InventoryCountLine[]

  @@index([status, createdAt])
  @@map("inventory_counts")
}

model InventoryCountLine {
  id               String         @id @default(uuid())
  countId          String
  count            InventoryCount @relation(fields: [countId], references: [id], onDelete: Cascade)
  productId        String
  product          Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  // `null` mientras nadie lo cuente. Volver a contar sobrescribe los tres.
  countedQuantity  Int?
  expectedQuantity Int?
  countedAt        DateTime?
  countedByEmail   String?
  // Lo que se aplicó al cerrar, y el coste medio de ese momento para valorar la diferencia
  // (T5-01). `adjustment` es `null` en las no contadas y 0 en las que cuadraban.
  adjustment       Int?
  unitCost         Decimal?       @db.Decimal(12, 4)

  @@unique([countId, productId])
  @@index([productId])
  @@map("inventory_count_lines")
}

// ─── T5-11 — Resumen semanal por correo ────────────────────────────────────────
//
// Una fila por semana resumida. El backend no tiene planificador: el resumen lo lanza un
// comando programado desde fuera, y esta tabla es lo que impide que dos ejecuciones —dos
// réplicas, un cron mal puesto, alguien que lo repite a mano— manden el mismo correo dos veces.

model WeeklyDigest {
  id            String    @id @default(uuid())
  // El lunes de la semana resumida, `AAAA-MM-DD` en la zona del negocio. **Único**: crear la
  // fila es reclamar la semana, y la base decide quién gana si dos lo intentan a la vez.
  weekStart     String    @unique
  weekEnd       String
  // A quién le llegó ya, por id de usuario y no por correo: una ejecución que falló a medias
  // se repite solo para los que faltan, y la dirección no se copia a un segundo sitio.
  sentToUserIds String[]
  // `finishedAt` a `null` con un `startedAt` reciente es una ejecución en curso; con uno
  // antiguo, una que murió a medias y se puede retomar.
  startedAt     DateTime  @default(now())
  finishedAt    DateTime?

  @@map("weekly_digests")
}

// ─── T5-12 — Avisos dentro de la aplicación ────────────────────────────────────
//
// La alerta de stock bajo solo salía por correo, y solo si estaba activada: quien tenía la
// aplicación abierta no se enteraba. Un aviso es de **un usuario** y habla de **una cosa** —un
// producto, una venta, una compra—.

enum NotificationType {
  LOW_STOCK
  SALE_UNSHIPPABLE
  PURCHASE_OVERDUE
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  // Los avisos de una cuenta borrada no son de nadie: se van con ella.
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  // De qué habla: el producto, la venta o la compra. Sin clave foránea a propósito —son tres
  // tablas distintas—; si aquello se borra, el aviso sigue diciendo lo que pasó.
  entityId  String
  // Los huecos del texto —nombre del producto, cantidades, fecha—, no el texto: lo compone la
  // interfaz en el idioma de quien lo lee (T4-04), y una copia del momento no cambia si luego
  // el producto se renombra. La forma de cada tipo está en `avisoSchema`, en el contrato.
  data      Json
  readAt    DateTime?
  createdAt DateTime         @default(now())

  // **Un aviso por usuario y asunto.** Que el mismo producto vuelva a bajar no apila una fila
  // más: reabre la que había, con las cifras nuevas. Es también lo que deja generar los avisos
  // de compras atrasadas con un `ON CONFLICT DO NOTHING`, sin apuntar aparte cuáles ya se dieron.
  @@unique([userId, type, entityId])
  // La campana: los últimos de un usuario, y cuántos tiene sin leer.
  @@index([userId, createdAt])
  // La purga de los leídos hace más de 90 días.
  @@index([readAt])
  @@map("notifications")
}
