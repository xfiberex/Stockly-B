// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum PurchaseOrderStatus {
  PENDING
  RECEIVED
  CANCELLED
}

enum SaleOrderStatus {
  PENDING
  SHIPPED
  CANCELLED
}

enum StockMovementType {
  IN
  OUT
  ADJUSTMENT
  IMPORT
}

// T3-02 — los tres que la conversión a enums de 2026-06-01 dejó fuera.
//
// No es cosmética: mientras `role` fue `String`, la base aceptaba `"admin"`, `"ADMIN "`
// o cualquier cadena, y el único filtro era el `z.enum` de la ruta. Todo lo que escriba
// saltándose esa ruta —una migración, un seed, un `psql` a mano— podía dejar una cuenta
// con un rol que `requireRole` no reconoce: sin permisos y sin error visible.
enum Role {
  ADMIN
  USER
}

// T4-12 — el idioma en el que se le escribe a este usuario.
//
// **No es la preferencia de la interfaz.** Esa vive en el `localStorage` del navegador y es
// por dispositivo (ver `Stockly-F/src/shared/i18n/idioma.ts`): el mismo usuario puede tener
// el portátil en inglés y el móvil en español, y las dos cosas son correctas. Un correo, en
// cambio, se escribe **una vez y sin nadie delante** —la alerta de stock la dispara una venta,
// no una pantalla—, así que hace falta un idioma guardado por usuario. Este es el último
// efectivo que se le conoce, sincronizado desde el navegador.
enum Idioma {
  ES
  EN
}

// Reflejan `AuditAction` y `AuditEntity` de `audit-logs.service.ts`, que ahora se
// importan del cliente generado en vez de declararse dos veces. Añadir un valor aquí
// es lo que lo hace existir para TypeScript, así que los dos lados no pueden separarse.
enum AuditAction {
  CREATE
  UPDATE
  DELETE
  RESTORE
  STOCK_MOVEMENT
  BULK_STOCK
  ORDER_RECEIVE
  ORDER_CANCEL
  USER_ROLE_CHANGE
  USER_ACTIVATE
  USER_DEACTIVATE
  SALE_SHIP
  SALE_CANCEL
  REFRESH_REUSE
}

enum AuditEntity {
  Product
  PurchaseOrder
  SaleOrder
  User
  Tag
  Category
  Brand
  Supplier
}

model Category {
  id          String    @id @default(uuid())
  name        String    @unique
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  products    Product[]

  @@map("categories")
}

model Brand {
  id          String    @id @default(uuid())
  name        String    @unique
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  products    Product[]

  @@map("brands")
}

model Supplier {
  id             String          @id @default(uuid())
  name           String
  email          String?         @unique
  phone          String?
  notes          String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  products       Product[]
  purchaseOrders PurchaseOrder[]

  @@map("suppliers")
}

model Product {
  id            String     @id @default(uuid())
  name          String
  description   String?
  sku           String?    @unique
  price         Decimal    @db.Decimal(10, 2)
  stock         Int        @default(0)
  minStock      Int        @default(0)
  categoryId    String?
  category      Category?  @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  brandId       String?
  brand         Brand?     @relation(fields: [brandId], references: [id], onDelete: SetNull)
  supplierId    String?
  supplier      Supplier?  @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  imageUrl      String?
  imagePublicId String?
  isActive      Boolean    @default(true)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  movements     StockMovement[]
  priceHistory  PriceHistory[]
  purchaseItems PurchaseOrderItem[]
  saleItems     SaleOrderItem[]
  tags          Tag[]

  // PostgreSQL no indexa las claves foráneas por sí solo: sin esto, filtrar por
  // categoría, marca o proveedor recorre la tabla entera.
  @@index([categoryId])
  @@index([brandId])
  @@index([supplierId])
  // Todos los listados del catálogo ordenan por `createdAt` y el filtro por estado es
  // opcional, así que hacen falta las dos formas (T2-43):
  //   - sin filtro          → `products_createdAt_idx`
  //   - con `?isActive=`    → el compuesto, que ordena dentro de cada estado.
  // El compuesto sustituye al índice sobre `isActive` solo, que el planificador
  // descartaba en la consulta dominante y solo servía al filtro inverso; como prefijo
  // del compuesto, ese caso sigue cubierto sin un índice propio.
  @@index([createdAt])
  @@index([isActive, createdAt])
  // La búsqueda del catálogo es `ILIKE '%término%'`, y un B-tree no sirve para un patrón
  // que no empieza por prefijo: hay que recorrer la tabla. Un índice GIN de trigramas sí
  // (T2-09). Requiere la extensión `pg_trgm`, que crea la propia migración.
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin)
  @@map("products")
}

model PriceHistory {
  id        String   @id @default(uuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  oldPrice  Decimal  @db.Decimal(10, 2)
  newPrice  Decimal  @db.Decimal(10, 2)
  createdAt DateTime @default(now())

  @@index([productId])
  @@map("price_history")
}

model PurchaseOrder {
  id         String              @id @default(uuid())
  supplierId String?
  supplier   Supplier?           @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  status     PurchaseOrderStatus @default(PENDING)
  notes      String?
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt
  items      PurchaseOrderItem[]

  @@index([status, createdAt])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id              String        @id @default(uuid())
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  productId       String?
  product         Product?      @relation(fields: [productId], references: [id], onDelete: SetNull)
  productName     String
  quantity        Int
  unitPrice       Decimal       @db.Decimal(10, 2)
  createdAt       DateTime      @default(now())

  @@index([purchaseOrderId])
  @@index([productId])
  @@map("purchase_order_items")
}

model StockMovement {
  id         String            @id @default(uuid())
  productId  String
  product    Product           @relation(fields: [productId], references: [id])
  type       StockMovementType
  delta      Int               // positivo = entrada, negativo = salida
  stockAfter Int               // stock resultante tras el movimiento
  note       String?
  createdAt  DateTime          @default(now())

  // El histórico de un producto se lee siempre ordenado por fecha: el índice
  // compuesto sirve el filtro y el orden de una sola pasada.
  @@index([productId, createdAt])
  @@index([createdAt])
  @@map("stock_movements")
}

model User {
  id             String    @id @default(uuid())
  name           String
  email          String    @unique
  password       String
  role           Role      @default(USER)
  // Por defecto español: es el idioma de referencia del catálogo, y una cuenta creada por
  // seed o por migración no tiene ningún navegador detrás del que deducirlo (T4-12).
  idioma         Idioma    @default(ES)
  isActive       Boolean   @default(true)
  isVerified     Boolean   @default(false)
  verifyToken    String?   @unique
  verifyExpires  DateTime?
  resetToken     String?   @unique
  resetExpires   DateTime?
  refreshToken   String?   @unique
  refreshExpires DateTime?
  // T2-31 — el hash del refresh token **anterior**, el que acaba de rotarse. Si llega uno
  // que ya no está en `refreshToken` pero sí aquí, alguien está reutilizando un token ya
  // gastado: la sesión se cierra entera y queda constancia en la auditoría.
  previousRefreshToken String? @unique
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  // El buscador de usuarios mira **nombre y correo** con el mismo `ILIKE '%…%'`, así que
  // se indexan los dos: con uno solo, la mitad del `OR` seguiría recorriendo la tabla y
  // el planificador descartaría el índice entero (T2-09).
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin)
  @@index([email(ops: raw("gin_trgm_ops"))], type: Gin)
  @@map("users")
}

model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt

  @@map("app_settings")
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  userEmail String?
  action    AuditAction
  entity    AuditEntity
  entityId  String?
  details   Json?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([entity, action])
  @@map("audit_logs")
}

model Tag {
  id        String    @id @default(uuid())
  name      String    @unique
  color     String?
  products  Product[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@map("tags")
}

model SaleOrder {
  id            String          @id @default(uuid())
  status        SaleOrderStatus @default(PENDING)
  customerName  String?
  customerEmail String?
  customerPhone String?
  notes         String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  items         SaleOrderItem[]

  @@index([status, createdAt])
  @@map("sale_orders")
}

model SaleOrderItem {
  id          String    @id @default(uuid())
  saleOrderId String
  saleOrder   SaleOrder @relation(fields: [saleOrderId], references: [id], onDelete: Cascade)
  productId   String?
  product     Product?  @relation(fields: [productId], references: [id], onDelete: SetNull)
  productName String
  quantity    Int
  unitPrice   Decimal   @db.Decimal(10, 2)
  createdAt   DateTime  @default(now())

  @@index([saleOrderId])
  @@index([productId])
  @@map("sale_order_items")
}