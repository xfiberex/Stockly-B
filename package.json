{
  "name": "product-inventory-b",
  "version": "1.0.0",
  "description": "Inventario de Productos Simple",
  "main": "dist/server.js",
  "scripts": {
    "dev": "nodemon src/server.ts",
    "prebuild": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "tsc && tsc-alias",
    "check": "tsc --noEmit",
    "start": "node dist/server.js",
    "db:migrate": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "db:reset": "prisma migrate reset",
    "db:backup": "node scripts/backup.js",
    "db:restaurar": "node scripts/restaurar.js",
    "test": "jest --runInBand --forceExit --detectOpenHandles",
    "test:watch": "jest --watch --runInBand",
    "test:coverage": "jest --coverage --runInBand --forceExit",
    "smoke": "node scripts/smoke.js",
    "auditoria": "node scripts/auditoria.js",
    "carga:sembrar": "node load/sembrar.js",
    "carga:consultas": "node load/consultas.js",
    "carga:ejecutar": "node load/ejecutar.js",
    "contratos:generar": "node scripts/generar-contratos.js",
    "verify": "pnpm exec prisma generate && pnpm exec prisma migrate deploy && pnpm run check && pnpm run test:coverage && pnpm run build && pnpm run smoke && pnpm run auditoria"
  },
  "keywords": [],
  "author": "Ricky Angel Jiménez Bueno",
  "license": "MIT",
  "packageManager": "pnpm@11.21.0",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.21.0",
      "onFail": "download"
    }
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.10.0",
    "colors": "^1.4.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.11.0",
    "multer": "^2.2.0",
    "nodemailer": "^9.0.5",
    "pdfkit": "^0.18.0",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "prisma": "^7.9.1",
    "prom-client": "^15.1.3",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^25.9.5",
    "@types/nodemailer": "^8.0.1",
    "@types/pdfkit": "^0.17.6",
    "@types/supertest": "^7.2.1",
    "@types/swagger-ui-express": "^4.1.8",
    "jest": "^30.4.2",
    "nodemon": "^3.1.14",
    "pino-pretty": "^13.1.3",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.12",
    "tsc-alias": "^1.9.1",
    "tsx": "^4.23.11",
    "typescript": "^6.0.3"
  }
}