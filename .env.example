# ─────────────────────────────────────────────────────────────
# IMPRESCINDIBLES — sin ellas el servidor no arranca
# ─────────────────────────────────────────────────────────────

# Base de datos PostgreSQL
DATABASE_URL=

# JWT. El secreto necesita 32 caracteres como mínimo.
# Con refresh tokens activos, el access token debe ser de corta duración.
JWT_SECRET=
JWT_EXPIRES_IN=15m

# URL del frontend (enlaces de los correos y origen permitido por CORS)
FRONTEND_URL=http://localhost:5173

# ─────────────────────────────────────────────────────────────
# OPCIONALES — con valores por defecto
# ─────────────────────────────────────────────────────────────

PORT=3000
NODE_ENV=development

# ─────────────────────────────────────────────────────────────
# OPCIONALES POR GRUPO — el servidor arranca sin ellas, pero la
# función correspondiente responde 503 al invocarla. Un grupo a
# medias no vale: o las cinco de SMTP, o ninguna.
# ─────────────────────────────────────────────────────────────

# Cloudinary — subida de imágenes de producto
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# SMTP — verificación de cuenta, reset de contraseña y alertas de stock.
# El puerto 465 usa TLS implícito; en cualquier otro se exige STARTTLS.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# ─────────────────────────────────────────────────────────────
# OBSERVABILIDAD (T4-06)
# ─────────────────────────────────────────────────────────────

# Token que protege GET /api/v1/metrics. **Sin él, en producción el endpoint
# responde 404**: fuera de producción queda abierto. El mismo valor va en
# `observabilidad/secretos/metrics-token` para que Prometheus pueda raspar.
METRICS_TOKEN=

# Alerta por pico de errores 5xx del propio proceso. Los valores por defecto son
# los de abajo; en `test` viene apagada salvo que se ponga a true.
ALERTA_5XX_HABILITADA=true
ALERTA_5XX_UMBRAL=5
ALERTA_5XX_VENTANA_MIN=5
ALERTA_5XX_ENFRIAMIENTO_MIN=30
